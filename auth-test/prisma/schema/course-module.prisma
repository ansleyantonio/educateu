model CourseModule {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cModuleId    String
  cModule      CModule  @relation(fields: [cModuleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  index        Int?
  semesterNumber Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([courseId, cModuleId])
}
