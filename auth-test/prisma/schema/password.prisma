model PasswordReset {
  id        String   @id @default(uuid())
  otp       String
  expiredAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  otp       String
  expiredAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
}
