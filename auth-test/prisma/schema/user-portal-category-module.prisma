enum PermissionType {
  ROLE
  PERMANENT
  TEMPORARY
}

model UserPortalCategoryModule {
  id                  String         @id @default(uuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portalCategoryId    String
  portalCategory      PortalCategory @relation(fields: [portalCategoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  moduleId            String
  module              Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modulePermission    Json
  permissionType      PermissionType @default(PERMANENT)
  permissionStartDate DateTime?
  permissionEndDate   DateTime?
  manualRevocation    Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([userId, portalCategoryId, moduleId, permissionType])
}
