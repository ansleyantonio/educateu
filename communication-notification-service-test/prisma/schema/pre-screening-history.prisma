model PreScreeningHistory {
  id            String                 @id @default(uuid())
  application   Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applicationId String
  outcome       String
  template      String
  createdBy     UserPortalCategoryRole @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}
