model RegisteredStudent {
  id             String   @id @default(uuid())
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applicationId String @unique
  studentEnrollment StudentEnrollments @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentEnrollmentId String @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}