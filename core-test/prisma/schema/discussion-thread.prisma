enum CreatorType {
  STUDENT
  FACULTY
}

model ThreadLike {
  id String @id @default(uuid())

  // Relations
  threadId String
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate likes
  @@unique([threadId, studentId])
}

model ThreadView {
  id String @id @default(uuid())

  // Relations
  threadId String
  thread   DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicate views
  @@unique([threadId, studentId])
}

model DiscussionThread {
  id          String      @id @default(uuid())
  title       String
  content     String
  category    String
  creatorType CreatorType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sessionCourseId String
  sessionCourse   SessionCourse           @relation(fields: [sessionCourseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  studentId       String?
  student         Student?                @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facultyId       String?
  faculty         UserPortalCategoryRole? @relation(fields: [facultyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Comments relation
  threadComments ThreadComment[]

  threadLikes ThreadLike[]
  threadViews ThreadView[]
}
