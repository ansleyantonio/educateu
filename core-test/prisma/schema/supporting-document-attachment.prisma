model SupportingDocumentAttachment {
  id                   String             @id @default(uuid())
  supportingDocument   SupportingDocument @relation(fields: [supportingDocumentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  supportingDocumentId String
  attachment           Attachment         @relation(fields: [attachmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attachmentId         String
  name                 String
  status               String?            @default("PENDING")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}
