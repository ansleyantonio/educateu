// Core user model for authentication and profile management
model User {
  id                        String                     @id @default(uuid())
  userAccountNo             String?                     @unique
  firstName                 String
  lastName                  String
  email                     String?                    @unique
  mobile                    String?
  username                  String?                    @unique
  facultyUser               String?
  facultyEmail              String?
  agentUser                 String?
  agentEmail                String?
  password                  String // Hashed password
  address                   String?
  photo                     String? // Profile photo URL/path
  logoutTime                DateTime? // Track last logout time for session management
  emailVerified             Boolean                    @default(false)
  passwordChanged           Boolean                    @default(false) // Track if user changed default password
  // Device and security tracking
  browsersAndDevices        BrowsersAndDevices[]
  // Audit timestamps
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  // Password management
  passwordReset             PasswordReset[]
  resetToken                PasswordResetToken[]
  // Authorization and access control
  userRoles                 UserRole[]
  auditLogs                 AuditLog[]
  userPortalCategories      UserPortalCategory[]
  userPortalCategoryModules UserPortalCategoryModule[]
  // User account status and security settings
  userStatus                userStatus                 @default(ACTIVE)
  isForceLogout             Boolean                    @default(true) // Force logout flag for security
  mfaEnabled                Boolean                    @default(true) // Multi-factor authentication enabled
  lastMFALogin              DateTime                   @default(dbgenerated("'1970-01-01T00:00:00Z'"))
  // Relations for audit logging
  auditLogsTargetUser       AuditLog[]                 @relation("TargetUser")
  // Course and faculty associations
  courseFaculty             CourseFaculty[]
  studentSupportTickets     SupportRequest[]
  NotificationLog           NotificationLog[]
}

// Enumeration of possible user account statuses
enum userStatus {
  ACTIVE // User can access the system
  PENDING // User registration pending approval
  DEACTIVATED // User account temporarily disabled
  SUSPENDED // User account suspended due to violations
  DECLINED // User registration rejected
}

// Audit logging model for tracking user actions and system changes
model AuditLog {
  id            String   @id @default(uuid())
  action        String // Description of the action performed
  userId        String // ID of user who performed the action
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetUserId  String? // ID of user affected by the action (if applicable)
  targetUser    User?    @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  perviousValue String? // Previous value before change
  newValue      String? // New value after change
  actionType    String? // Categorization of action type
  moduleName    String? // Module/feature where action occurred
  courseId      String? // Course ID where action occurred
  moduleId      String? // Module ID where action occurred
  otherId       String? // Other ID related to the action
  createdAt     DateTime @default(now()) // When the action was logged
  updatedAt     DateTime @updatedAt // Last update timestamp
}
